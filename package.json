{
  "name": "codex-client",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --coverage"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/animations": "20.2.2",
    "@angular/cdk": "20.2.2",
    "@angular/common": "20.2.2",
    "@angular/compiler": "20.2.2",
    "@angular/core": "20.2.2",
    "@angular/forms": "20.2.2",
    "@angular/material": "20.2.2",
    "@angular/platform-browser": "20.2.2",
    "@angular/router": "20.2.2",
    "@ngx-translate/core": "^17.0.0",
    "@swimlane/ngx-graph": "^11.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.2.2",
    "@angular/cli": "20.2.2",
    "@angular/compiler-cli": "20.2.2",
    "@vitest/coverage-v8": "3.2.4",
    "jsdom": "^27.1.0",
    "msw": "^2.12.7",
    "typescript": "~5.9.2",
    "vitest": "3.2.4"
  }
}
